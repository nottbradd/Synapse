{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapse",
  "version": "1.0.0",
  "identifier": "com.synapse.study",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Synapse",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Light",
        "backgroundColor": "#FCFAF8",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "icons/icon.ico": "synapse-frost.ico"
    },
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/shortcuts.nsh"
      }
    },
    "shortDescription": "Your notes, connected.",
    "category": "Education"
  }
}
